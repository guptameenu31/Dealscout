# Copy this file to .env (same folder) and fill in values. Never commit .env.
# npm run dev / npm start / npm run demo / docker compose all load .env automatically.

# --- Gemini (pick ONE) ---
# Local dev: API key from https://aistudio.google.com, created in your Google Cloud project.
GEMINI_API_KEY=
# Cloud Run: Vertex AI in your Google Cloud project (no key; uses the service's identity).
# Setting this to true overrides GEMINI_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Model ID (check Vertex AI Model Garden / AI Studio for what your project can use)
GEMINI_MODEL=gemini-3.8-flash
# With no Gemini config: /api/spec uses the offline parser, /api/scout falls back to cached/demo data.

# Server (all optional; defaults shown)
PORT=8080
# Seconds-to-fallback for live search, in milliseconds
LIVE_TIMEOUT_MS=120000
# POST requests per minute per IP on /api (0 = unlimited)
RATE_LIMIT_PER_MIN=30
# Local storage for price history and the live-result cache
DATA_DIR=data
